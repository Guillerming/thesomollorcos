# Telegram: token de @BotFather e id del grupo (el bot lo imprime al recibir el primer mensaje)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Servidor local de la Bot API (docker compose up -d). api_id/api_hash: https://my.telegram.org/apps
# Deja TELEGRAM_API_BASE vacío para usar api.telegram.org (límite de 20 MB).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_BASE=http://127.0.0.1:8081

# Jira (visualink.atlassian.net). Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://visualink.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=TS
JIRA_ISSUE_TYPE=Post

# Carpeta de salida en Google Drive
DRIVE_OUT_DIR=~/Library/CloudStorage/GoogleDrive-<tu-correo>/My Drive/thesomollorcos
